# LibreOffice writes a lock file beside any document it has open. One was
# committed by a `git add -A` while a UAT checklist was being read.
.~lock.*#

# bd's audit log of field changes. Local history that every branch appends
# to, so it conflicts on every merge; .beads/issues.jsonl is the export that
# is meant to travel.
.beads/interactions.jsonl

# Beads workspace lock (bd 1.3.1+; bd init writes the same entry)
*.gate.lock*

# Sphinx output
docs/_build/
